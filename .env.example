# Copy to .env on the server. Never publish .env, .libtv or private-data.
# These defaults cannot collect payment.
PAID_ENABLED=false
# Free AI claims require wallet signature + human verification + unused browser identity.
# Default shared free pool: 5/day (Asia/Shanghai), 20 lifetime, 2/IP/day.
# Free trials consume the same administrator-approved LibTV generation budget.
AI_FIRST_FREE=true
HOST=127.0.0.1
PORT=4176
PAID_DATA_DIR=./private-data
FRONTEND_ORIGINS=http://127.0.0.1:4176,http://localhost:4176
SERVICE_DOMAIN=cz-heyi-photo-game
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# Managed Turnstile widget. Public sitekey is safe to expose; keep secret private.
# Production expected hostnames must exclude localhost / 127.0.0.1.
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=127.0.0.1,localhost
# Only enable with a loopback listener and trusted local Cloudflare Tunnel ingress.
# Then POST/trial routes require the Tunnel's valid CF-Connecting-IP header.
TRUST_CLOUDFLARE_LOOPBACK_PROXY=false
# Stable private random secret, minimum 32 characters. Do not rotate or publish it.
FREE_TRIAL_HMAC_SECRET=
FREE_TRIAL_TOTAL_LIMIT=20
FREE_TRIAL_DAILY_LIMIT=5
FREE_TRIAL_IP_DAILY_LIMIT=2
# Only new paid quotes use this deadline; old signed expiries remain unchanged.
PAID_ORDER_TTL_SECONDS=300

# Install and log in to the official CLI under the same server user.
# Leave LIBTV_CLI empty to use ~/.libtv/libtv (Windows: libtv.exe).
LIBTV_CLI=
LIBTV_PROJECT_UUID=
LIBTV_ACCOUNT_ID=
LIBTV_MODEL=General image Pro
# Lifetime ceiling of run intents in the durable provider-budget.json.
# After inspecting available LibTV credits, set old started count + approved
# additional generations. Membership status is not a live credit balance.
LIBTV_GENERATION_BUDGET=0
